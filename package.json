{
  "name": "reviewmp",
  "displayName": "ReviewMP - AI Code Review",
  "description": "Runtime-agnostic AI code review with inline comments",
  "version": "0.0.1",
  "publisher": "reviewmp",
  "repository": {
    "type": "git",
    "url": "https://github.com/alphaofficial/review-mp.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reviewmp.reviewFile",
        "title": "ReviewMP: Review Current File"
      },
      {
        "command": "reviewmp.reviewSelection",
        "title": "ReviewMP: Review Selection"
      },
      {
        "command": "reviewmp.reviewStaged",
        "title": "ReviewMP: Review Staged Changes"
      },
      {
        "command": "reviewmp.reviewUncommitted",
        "title": "ReviewMP: Review Uncommitted Changes"
      },
      {
        "command": "reviewmp.reviewLastCommit",
        "title": "ReviewMP: Review Last Commit"
      },
      {
        "command": "reviewmp.reviewBranch",
        "title": "ReviewMP: Review Branch Changes"
      },
      {
        "command": "reviewmp.clearComments",
        "title": "ReviewMP: Clear All Comments"
      },
      {
        "command": "reviewmp.acceptFix",
        "title": "Accept Fix",
        "icon": "$(check)"
      },
      {
        "command": "reviewmp.rejectComment",
        "title": "Dismiss",
        "icon": "$(circle-slash)"
      },
      {
        "command": "reviewmp.copyComment",
        "title": "Copy Comment",
        "icon": "$(copy)"
      },
      {
        "command": "reviewmp.collapseComment",
        "title": "Collapse",
        "icon": "$(chevron-up)"
      },
      {
        "command": "reviewmp.selectRuntime",
        "title": "ReviewMP: Select Runtime"
      },
      {
        "command": "reviewmp.showDebugLogs",
        "title": "ReviewMP: Show Debug Logs"
      },
      {
        "command": "reviewmp.reviewAllChanges",
        "title": "ReviewMP: Review All Changes"
      },
      {
        "command": "reviewmp.openFinding",
        "title": "ReviewMP: Open Finding"
      },
      {
        "command": "reviewmp.applyFindingFix",
        "title": "ReviewMP: Apply Fix"
      },
      {
        "command": "reviewmp.dismissFinding",
        "title": "ReviewMP: Dismiss Finding"
      },
      {
        "command": "reviewmp.clearActiveReview",
        "title": "ReviewMP: Clear Active Review"
      },
      {
        "command": "reviewmp.openReviewPanel",
        "title": "ReviewMP: Open Review Panel"
      },
      {
        "command": "reviewmp.enableCodeIndex",
        "title": "ReviewMP: Enable Code Indexing"
      },
      {
        "command": "reviewmp.disableCodeIndex",
        "title": "ReviewMP: Disable Code Indexing"
      },
      {
        "command": "reviewmp.rebuildCodeIndex",
        "title": "ReviewMP: Rebuild Code Index"
      },
      {
        "command": "reviewmp.stopCodeIndex",
        "title": "ReviewMP: Stop Code Indexing"
      },
      {
        "command": "reviewmp.clearCodeIndex",
        "title": "ReviewMP: Clear Code Index Data"
      }
    ],
    "menus": {
      "comments/comment/title": [
        {
          "command": "reviewmp.acceptFix",
          "group": "inline@1",
          "when": "commentController == reviewmp && comment == reviewmp-with-fix"
        },
        {
          "command": "reviewmp.rejectComment",
          "group": "inline@2",
          "when": "commentController == reviewmp && (comment == reviewmp || comment == reviewmp-with-fix)"
        },
        {
          "command": "reviewmp.copyComment",
          "group": "inline@3",
          "when": "commentController == reviewmp && (comment == reviewmp || comment == reviewmp-with-fix)"
        },
        {
          "command": "reviewmp.collapseComment",
          "group": "inline@4",
          "when": "commentController == reviewmp && (comment == reviewmp || comment == reviewmp-with-fix)"
        }
      ],
      "editor/context": [
        {
          "command": "reviewmp.reviewFile",
          "group": "reviewmp@1",
          "title": "ReviewMP: Review Current File"
        },
        {
          "command": "reviewmp.reviewSelection",
          "group": "reviewmp@2",
          "when": "editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "reviewmp.reviewFile",
          "group": "reviewmp@1",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "view/title": [
        {
          "command": "reviewmp.clearActiveReview",
          "when": "view == reviewmp.reviews",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "reviewmp.openFinding",
          "when": "view == reviewmp.reviews && viewItem == finding",
          "group": "navigation@1"
        },
        {
          "command": "reviewmp.applyFindingFix",
          "when": "view == reviewmp.reviews && viewItem == findingWithFix",
          "group": "action@1"
        },
        {
          "command": "reviewmp.dismissFinding",
          "when": "view == reviewmp.reviews && viewItem == finding",
          "group": "action@2"
        },
        {
          "command": "reviewmp.openReviewPanel",
          "when": "view == reviewmp.reviews && viewItem == previousReview",
          "group": "navigation@1"
        }
      ],
      "view/container/reviewmp": [
        {
          "command": "reviewmp.clearActiveReview",
          "when": "view == reviewmp.reviews"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reviewmp",
          "title": "ReviewMP",
          "icon": "resources/reviewmp.svg"
        }
      ]
    },
    "views": {
      "reviewmp": [
        {
          "id": "reviewmp.newReview",
          "name": "NEW REVIEW",
          "icon": "$(git-compare)"
        },
        {
          "id": "reviewmp.filesToReview",
          "name": "FILES",
          "icon": "$(files)"
        },
        {
          "id": "reviewmp.reviews",
          "name": "REVIEWS",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "reviewmp.previousReviews",
          "name": "PREVIOUS REVIEWS",
          "icon": "$(history)"
        },
        {
          "id": "reviewmp.indexing",
          "name": "INDEXING",
          "icon": "$(database)"
        }
      ]
    },
    "configuration": {
      "title": "ReviewMP",
      "properties": {
        "reviewmp.runtime": {
          "type": "string",
          "default": "opencode",
          "enum": [
            "claude",
            "copilot",
            "codex",
            "gemini",
            "hermes",
            "pi",
            "opencode"
          ],
          "description": "Runtime to use for code reviews"
        },
        "reviewmp.model": {
          "type": "string",
          "default": "",
          "description": "Model to use for reviews. Leave empty for runtime default. Format varies by runtime."
        },
        "reviewmp.autoReviewOnStage": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run review when files are staged (git add)"
        },
        "reviewmp.autoReviewOnCommit": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run a review when a commit is created"
        },
        "reviewmp.codeIndexEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable background repository indexing for review memory and related-code retrieval"
        },
        "reviewmp.reviewConcurrency": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum number of file review scopes to run in parallel"
        },
        "reviewmp.executableOverride": {
          "type": "string",
          "default": "",
          "description": "Override the default executable path for the selected runtime"
        },
        "reviewmp.extraArgs": {
          "type": "string",
          "default": "",
          "description": "Additional arguments to pass to the runtime executable"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "apache-arrow": "^18.1.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2",
    "ts-morph": "^28.0.0"
  }
}
