{
  "name": "codebunny",
  "displayName": "CodeBunny - AI Code Review",
  "description": "Runtime-agnostic AI code review with inline comments",
  "version": "0.0.1",
  "publisher": "codebunny",
  "repository": {
    "type": "git",
    "url": "https://github.com/alphaofficial/codebunny.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codebunny.reviewFile",
        "title": "CodeBunny: Review Current File"
      },
      {
        "command": "codebunny.reviewSelection",
        "title": "CodeBunny: Review Selection"
      },
      {
        "command": "codebunny.reviewStaged",
        "title": "CodeBunny: Review Staged Changes"
      },
      {
        "command": "codebunny.reviewUncommitted",
        "title": "CodeBunny: Review Uncommitted Changes"
      },
      {
        "command": "codebunny.reviewLastCommit",
        "title": "CodeBunny: Review Last Commit"
      },
      {
        "command": "codebunny.reviewBranch",
        "title": "CodeBunny: Review Branch Changes"
      },
      {
        "command": "codebunny.clearComments",
        "title": "CodeBunny: Clear All Comments"
      },
      {
        "command": "codebunny.acceptFix",
        "title": "Accept Fix",
        "icon": "$(check)"
      },
      {
        "command": "codebunny.rejectComment",
        "title": "Dismiss",
        "icon": "$(circle-slash)"
      },
      {
        "command": "codebunny.copyComment",
        "title": "Copy Comment",
        "icon": "$(copy)"
      },
      {
        "command": "codebunny.collapseComment",
        "title": "Collapse",
        "icon": "$(chevron-up)"
      },
      {
        "command": "codebunny.selectRuntime",
        "title": "CodeBunny: Select Runtime"
      },
      {
        "command": "codebunny.showDebugLogs",
        "title": "CodeBunny: Show Debug Logs"
      },
      {
        "command": "codebunny.reviewAllChanges",
        "title": "CodeBunny: Review All Changes"
      },
      {
        "command": "codebunny.openFinding",
        "title": "CodeBunny: Open Finding"
      },
      {
        "command": "codebunny.applyFindingFix",
        "title": "CodeBunny: Apply Fix"
      },
      {
        "command": "codebunny.dismissFinding",
        "title": "CodeBunny: Dismiss Finding"
      },
      {
        "command": "codebunny.clearActiveReview",
        "title": "CodeBunny: Clear Active Review"
      },
      {
        "command": "codebunny.openReviewPanel",
        "title": "CodeBunny: Open Review Panel"
      },
      {
        "command": "codebunny.enableCodeIndex",
        "title": "CodeBunny: Enable Code Indexing"
      },
      {
        "command": "codebunny.disableCodeIndex",
        "title": "CodeBunny: Disable Code Indexing"
      },
      {
        "command": "codebunny.rebuildCodeIndex",
        "title": "CodeBunny: Rebuild Code Index"
      },
      {
        "command": "codebunny.stopCodeIndex",
        "title": "CodeBunny: Stop Code Indexing"
      },
      {
        "command": "codebunny.clearCodeIndex",
        "title": "CodeBunny: Clear Code Index Data"
      }
    ],
    "menus": {
      "comments/comment/title": [
        {
          "command": "codebunny.acceptFix",
          "group": "inline@1",
          "when": "commentController == codebunny && comment == codebunny-with-fix"
        },
        {
          "command": "codebunny.rejectComment",
          "group": "inline@2",
          "when": "commentController == codebunny && (comment == codebunny || comment == codebunny-with-fix)"
        },
        {
          "command": "codebunny.copyComment",
          "group": "inline@3",
          "when": "commentController == codebunny && (comment == codebunny || comment == codebunny-with-fix)"
        },
        {
          "command": "codebunny.collapseComment",
          "group": "inline@4",
          "when": "commentController == codebunny && (comment == codebunny || comment == codebunny-with-fix)"
        }
      ],
      "editor/context": [
        {
          "command": "codebunny.reviewFile",
          "group": "codebunny@1",
          "title": "CodeBunny: Review Current File"
        },
        {
          "command": "codebunny.reviewSelection",
          "group": "codebunny@2",
          "when": "editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "codebunny.reviewFile",
          "group": "codebunny@1",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "view/title": [
        {
          "command": "codebunny.clearActiveReview",
          "when": "view == codebunny.reviews",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codebunny.openFinding",
          "when": "view == codebunny.reviews && viewItem == finding",
          "group": "navigation@1"
        },
        {
          "command": "codebunny.applyFindingFix",
          "when": "view == codebunny.reviews && viewItem == findingWithFix",
          "group": "action@1"
        },
        {
          "command": "codebunny.dismissFinding",
          "when": "view == codebunny.reviews && viewItem == finding",
          "group": "action@2"
        },
        {
          "command": "codebunny.openReviewPanel",
          "when": "view == codebunny.reviews && viewItem == previousReview",
          "group": "navigation@1"
        }
      ],
      "view/container/codebunny": [
        {
          "command": "codebunny.clearActiveReview",
          "when": "view == codebunny.reviews"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codebunny",
          "title": "CodeBunny",
          "icon": "resources/codebunny.svg"
        }
      ]
    },
    "views": {
      "codebunny": [
        {
          "id": "codebunny.newReview",
          "name": "NEW REVIEW",
          "icon": "$(git-compare)"
        },
        {
          "id": "codebunny.filesToReview",
          "name": "FILES",
          "icon": "$(files)"
        },
        {
          "id": "codebunny.reviews",
          "name": "REVIEWS",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "codebunny.previousReviews",
          "name": "PREVIOUS REVIEWS",
          "icon": "$(history)"
        },
        {
          "id": "codebunny.indexing",
          "name": "INDEXING",
          "icon": "$(database)"
        }
      ]
    },
    "configuration": {
      "title": "CodeBunny",
      "properties": {
        "codebunny.runtime": {
          "type": "string",
          "default": "opencode",
          "enum": [
            "claude",
            "copilot",
            "codex",
            "gemini",
            "hermes",
            "pi",
            "opencode"
          ],
          "description": "Runtime to use for code reviews"
        },
        "codebunny.model": {
          "type": "string",
          "default": "",
          "description": "Model to use for reviews. Leave empty for runtime default. Format varies by runtime."
        },
        "codebunny.autoReviewOnStage": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run review when files are staged (git add)"
        },
        "codebunny.autoReviewOnCommit": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run a review when a commit is created"
        },
        "codebunny.codeIndexEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable background repository indexing for review memory and related-code retrieval"
        },
        "codebunny.reviewConcurrency": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum number of file review scopes to run in parallel"
        },
        "codebunny.executableOverride": {
          "type": "string",
          "default": "",
          "description": "Override the default executable path for the selected runtime"
        },
        "codebunny.extraArgs": {
          "type": "string",
          "default": "",
          "description": "Additional arguments to pass to the runtime executable"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run typecheck && node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p ./",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "apache-arrow": "^18.1.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c": "0.23.1",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-cpp": "0.22.0",
    "tree-sitter-go": "0.23.4",
    "tree-sitter-java": "0.21.0",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "0.23.12",
    "tree-sitter-python": "0.21.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "0.21.0",
    "tree-sitter-typescript": "0.21.2",
    "ts-morph": "^28.0.0"
  }
}
