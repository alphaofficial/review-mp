{
  "name": "reviewmp",
  "displayName": "ReviewMP - AI Code Review",
  "description": "AI-powered code review with inline comments using OpenCode CLI",
  "version": "0.0.1",
  "publisher": "reviewmp",
  "repository": {
    "type": "git",
    "url": "https://github.com/alphaofficial/review-mp.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reviewmp.reviewFile",
        "title": "ReviewMP: Review Current File"
      },
      {
        "command": "reviewmp.reviewSelection",
        "title": "ReviewMP: Review Selection"
      },
      {
        "command": "reviewmp.reviewStaged",
        "title": "ReviewMP: Review Staged Changes"
      },
      {
        "command": "reviewmp.reviewUncommitted",
        "title": "ReviewMP: Review Uncommitted Changes"
      },
      {
        "command": "reviewmp.reviewLastCommit",
        "title": "ReviewMP: Review Last Commit"
      },
      {
        "command": "reviewmp.reviewBranch",
        "title": "ReviewMP: Review Branch Changes"
      },
      {
        "command": "reviewmp.reviewPR",
        "title": "ReviewMP: Review Pull Request"
      },
      {
        "command": "reviewmp.clearComments",
        "title": "ReviewMP: Clear All Comments"
      },
      {
        "command": "reviewmp.acceptFix",
        "title": "Accept Fix",
        "icon": "$(check)"
      },
      {
        "command": "reviewmp.rejectComment",
        "title": "Reject",
        "icon": "$(x)"
      },
      {
        "command": "reviewmp.setApiKey",
        "title": "ReviewMP: Set API Key"
      },
      {
        "command": "reviewmp.clearApiKey",
        "title": "ReviewMP: Clear API Key"
      },
      {
        "command": "reviewmp.selectProvider",
        "title": "ReviewMP: Select Provider"
      },
      {
        "command": "reviewmp.toggleDebug",
        "title": "ReviewMP: Toggle Debug Mode"
      }
    ],
    "menus": {
      "comments/comment/title": [
        {
          "command": "reviewmp.acceptFix",
          "group": "inline@1",
          "when": "commentController == reviewmp && comment =~ /with-fix/"
        },
        {
          "command": "reviewmp.rejectComment",
          "group": "inline@2",
          "when": "commentController == reviewmp"
        }
      ],
      "editor/context": [
        {
          "command": "reviewmp.reviewFile",
          "group": "reviewmp@1",
          "title": "ReviewMP: Review Current File"
        },
        {
          "command": "reviewmp.reviewSelection",
          "group": "reviewmp@2",
          "when": "editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "reviewmp.reviewFile",
          "group": "reviewmp@1",
          "when": "!explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "ReviewMP",
      "properties": {
        "reviewmp.provider": {
          "type": "string",
          "default": "opencode",
          "enum": ["opencode", "custom-cli", "openai-compatible"],
          "description": "Provider to use for code reviews"
        },
        "reviewmp.opencodePath": {
          "type": "string",
          "default": "opencode",
          "description": "Path to the OpenCode CLI executable"
        },
        "reviewmp.model": {
          "type": "string",
          "default": "",
          "description": "Model to use for reviews in provider/model format (e.g., github-copilot/gpt-4o, github-copilot/claude-sonnet-4). Leave empty for default."
        },
        "reviewmp.autoReviewOnStage": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run review when files are staged (git add)"
        },
        "reviewmp.autoReviewOnCommit": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run review before commit (requires pre-commit hook setup)"
        },
        "reviewmp.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging for provider requests and responses"
        },
        "reviewmp.customCliCommand": {
          "type": "string",
          "default": "",
          "description": "Custom CLI command to use for reviews (used when provider is custom-cli)"
        },
        "reviewmp.customCliArgs": {
          "type": "string",
          "default": "",
          "description": "Additional arguments for custom CLI command"
        },
        "reviewmp.openaiCompatibleEndpoint": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible API endpoint URL (used when provider is openai-compatible)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  }
}
