{
  "name": "reviewmp",
  "displayName": "ReviewMP - AI Code Review",
  "description": "Runtime-agnostic AI code review with inline comments",
  "version": "0.0.1",
  "publisher": "reviewmp",
  "repository": {
    "type": "git",
    "url": "https://github.com/alphaofficial/review-mp.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reviewmp.reviewFile",
        "title": "ReviewMP: Review Current File"
      },
      {
        "command": "reviewmp.reviewSelection",
        "title": "ReviewMP: Review Selection"
      },
      {
        "command": "reviewmp.reviewStaged",
        "title": "ReviewMP: Review Staged Changes"
      },
      {
        "command": "reviewmp.reviewUncommitted",
        "title": "ReviewMP: Review Uncommitted Changes"
      },
      {
        "command": "reviewmp.reviewLastCommit",
        "title": "ReviewMP: Review Last Commit"
      },
      {
        "command": "reviewmp.reviewBranch",
        "title": "ReviewMP: Review Branch Changes"
      },
      {
        "command": "reviewmp.reviewPR",
        "title": "ReviewMP: Review Pull Request"
      },
      {
        "command": "reviewmp.clearComments",
        "title": "ReviewMP: Clear All Comments"
      },
      {
        "command": "reviewmp.acceptFix",
        "title": "Accept Fix",
        "icon": "$(check)"
      },
      {
        "command": "reviewmp.rejectComment",
        "title": "Dismiss",
        "icon": "$(circle-slash)"
      },
      {
        "command": "reviewmp.copyComment",
        "title": "Copy Comment",
        "icon": "$(copy)"
      },
      {
        "command": "reviewmp.collapseComment",
        "title": "Collapse",
        "icon": "$(chevron-up)"
      },
      {
        "command": "reviewmp.selectRuntime",
        "title": "ReviewMP: Select Runtime"
      },
      {
        "command": "reviewmp.toggleDebug",
        "title": "ReviewMP: Toggle Debug Mode"
      },
      {
        "command": "reviewmp.reviewAllChanges",
        "title": "ReviewMP: Review All Changes"
      },
      {
        "command": "reviewmp.openFinding",
        "title": "ReviewMP: Open Finding"
      },
      {
        "command": "reviewmp.applyFindingFix",
        "title": "ReviewMP: Apply Fix"
      },
      {
        "command": "reviewmp.dismissFinding",
        "title": "ReviewMP: Dismiss Finding"
      },
      {
        "command": "reviewmp.clearActiveReview",
        "title": "ReviewMP: Clear Active Review"
      },
      {
        "command": "reviewmp.openReviewPanel",
        "title": "ReviewMP: Open Review Panel"
      }
    ],
    "menus": {
      "comments/comment/title": [
        {
          "command": "reviewmp.acceptFix",
          "group": "inline@1",
          "when": "commentController == reviewmp && comment == reviewmp-with-fix"
        },
        {
          "command": "reviewmp.rejectComment",
          "group": "inline@2",
          "when": "commentController == reviewmp && (comment == reviewmp || comment == reviewmp-with-fix)"
        },
        {
          "command": "reviewmp.copyComment",
          "group": "inline@3",
          "when": "commentController == reviewmp && (comment == reviewmp || comment == reviewmp-with-fix)"
        },
        {
          "command": "reviewmp.collapseComment",
          "group": "inline@4",
          "when": "commentController == reviewmp && (comment == reviewmp || comment == reviewmp-with-fix)"
        }
      ],
      "editor/context": [
        {
          "command": "reviewmp.reviewFile",
          "group": "reviewmp@1",
          "title": "ReviewMP: Review Current File"
        },
        {
          "command": "reviewmp.reviewSelection",
          "group": "reviewmp@2",
          "when": "editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "reviewmp.reviewFile",
          "group": "reviewmp@1",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "view/title": [
        {
          "command": "reviewmp.clearActiveReview",
          "when": "view == reviewmp.reviews",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "reviewmp.openFinding",
          "when": "view == reviewmp.reviews && viewItem == finding",
          "group": "navigation@1"
        },
        {
          "command": "reviewmp.applyFindingFix",
          "when": "view == reviewmp.reviews && viewItem == findingWithFix",
          "group": "action@1"
        },
        {
          "command": "reviewmp.dismissFinding",
          "when": "view == reviewmp.reviews && viewItem == finding",
          "group": "action@2"
        },
        {
          "command": "reviewmp.openReviewPanel",
          "when": "view == reviewmp.reviews && viewItem == previousReview",
          "group": "navigation@1"
        }
      ],
      "view/container/reviewmp": [
        {
          "command": "reviewmp.clearActiveReview",
          "when": "view == reviewmp.reviews"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reviewmp",
          "title": "ReviewMP",
          "icon": "resources/reviewmp.svg"
        }
      ]
    },
    "views": {
      "reviewmp": [
        {
          "id": "reviewmp.newReview",
          "name": "NEW REVIEW",
          "icon": "$(git-compare)"
        },
        {
          "id": "reviewmp.filesToReview",
          "name": "FILES",
          "icon": "$(files)"
        },
        {
          "id": "reviewmp.reviews",
          "name": "REVIEWS",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "reviewmp.previousReviews",
          "name": "PREVIOUS REVIEWS",
          "icon": "$(history)"
        }
      ]
    },
    "configuration": {
      "title": "ReviewMP",
      "properties": {
        "reviewmp.runtime": {
          "type": "string",
          "default": "opencode",
          "enum": ["claude", "copilot", "codex", "gemini", "hermes", "pi", "opencode"],
          "description": "Runtime to use for code reviews"
        },
        "reviewmp.model": {
          "type": "string",
          "default": "",
          "description": "Model to use for reviews. Leave empty for runtime default. Format varies by runtime."
        },
        "reviewmp.autoReviewOnStage": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run review when files are staged (git add)"
        },
        "reviewmp.autoReviewOnCommit": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run review before commit (requires pre-commit hook setup)"
        },
        "reviewmp.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging for runtime requests and responses"
        },
        "reviewmp.executableOverride": {
          "type": "string",
          "default": "",
          "description": "Override the default executable path for the selected runtime"
        },
        "reviewmp.extraArgs": {
          "type": "string",
          "default": "",
          "description": "Additional arguments to pass to the runtime executable"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  }
}
